---
/**
 * Gallery
 * Storyblok block name: gallery
 *
 * Fields: eyebrow, headline, body, images (blocks → gallery_item: image, alt),
 * layout (masonry | grid), columns, background, anchor_id, lightbox_enabled
 *
 * layout=masonry keeps each image's natural aspect ratio and packs them into
 * a CSS multi-column layout (Pinterest-style, varying tile heights).
 * layout=grid instead crops every tile to the same square aspect ratio via
 * object-fit, so the grid reads as uniform rows/columns.
 */
import { storyblokEditable } from '@storyblok/astro';
import type { SbBlokData } from '@storyblok/astro';
import { imageSize } from '../lib/storyblok-image';

interface GalleryItem extends SbBlokData {
  image?: { filename: string; alt?: string };
  alt?: string;
}

const { blok } = Astro.props;

const layout    = blok.layout || 'masonry';
const columns   = blok.columns || 3;
const bg        = blok.background || 'primary';
const lightbox  = blok.lightbox_enabled ?? false;
const images: GalleryItem[] = blok.images ?? [];
const uid = `gallery-${blok._uid}`;
---

<section
  {...storyblokEditable(blok)}
  id={blok.anchor_id || undefined}
  class:list={['gallery', `gallery--${layout}`, `gallery--bg-${bg}`]}
>
  <div class="gallery__inner">
    {(blok.eyebrow || blok.headline || blok.body) && (
      <div class="gallery__header">
        {blok.eyebrow && <p class="gallery__eyebrow">{blok.eyebrow}</p>}
        {blok.headline && <h2 class="gallery__headline">{blok.headline}</h2>}
        {blok.body && <p class="gallery__body">{blok.body}</p>}
      </div>
    )}

    <div class:list={['gallery__grid', `gallery__grid--${columns}`]} data-reveal-stagger>
      {images.map((item, i) => {
        const imageUrl = item.image?.filename;
        if (!imageUrl) return null;
        const alt = item.alt || item.image?.alt || '';
        const fullUrl = `${imageUrl}/m/1600x0/filters:quality(85)`;

        const img = layout === 'grid' ? (
          <img
            {...imageSize(imageUrl, 800, 800)}
            src={`${imageUrl}/m/800x800/filters:quality(85)`}
            alt={alt}
            class="gallery__img"
            loading="lazy"
          />
        ) : (
          <img
            {...imageSize(imageUrl, 800, 0)}
            src={`${imageUrl}/m/800x0/filters:quality(85)`}
            alt={alt}
            class="gallery__img"
            loading="lazy"
          />
        );

        return lightbox ? (
          <button
            type="button"
            class="gallery__tile gallery__tile--button"
            {...storyblokEditable(item)}
            data-lightbox-trigger
            data-index={i}
            data-full={fullUrl}
            data-alt={alt}
            aria-label={`Open image ${i + 1} of ${images.length}${alt ? `: ${alt}` : ''}`}
          >
            {img}
          </button>
        ) : (
          <div class="gallery__tile" {...storyblokEditable(item)}>
            {img}
          </div>
        );
      })}
    </div>
  </div>

  {lightbox && (
    <div class="gallery__lightbox" data-lightbox-root id={uid} hidden>
      <div class="gallery__lightbox-backdrop" data-lightbox-close></div>
      <div class="gallery__lightbox-dialog" role="dialog" aria-modal="true" aria-label="Image viewer">
        <button type="button" class="gallery__lightbox-close" data-lightbox-close aria-label="Close">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 4L16 16M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <button type="button" class="gallery__lightbox-nav gallery__lightbox-nav--prev" data-lightbox-prev aria-label="Previous image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 6L9 12L15 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <img class="gallery__lightbox-img" data-lightbox-img src="" alt="" />
        <button type="button" class="gallery__lightbox-nav gallery__lightbox-nav--next" data-lightbox-next aria-label="Next image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 6L15 12L9 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <p class="gallery__lightbox-count" data-lightbox-count aria-live="polite"></p>
      </div>
    </div>
  )}
</section>

{lightbox && (
  <script define:vars={{ uid }}>
    (function () {
      const root = document.getElementById(uid);
      if (!root) return;
      const section = root.closest('.gallery');
      const triggers = Array.from(section.querySelectorAll('[data-lightbox-trigger]'));
      if (!triggers.length) return;

      const img = root.querySelector('[data-lightbox-img]');
      const count = root.querySelector('[data-lightbox-count]');
      const closeEls = root.querySelectorAll('[data-lightbox-close]');
      const prevBtn = root.querySelector('[data-lightbox-prev]');
      const nextBtn = root.querySelector('[data-lightbox-next]');

      let currentIndex = 0;
      let triggerEl = null;

      function show(index) {
        currentIndex = (index + triggers.length) % triggers.length;
        const t = triggers[currentIndex];
        img.src = t.dataset.full;
        img.alt = t.dataset.alt || '';
        count.textContent = `${currentIndex + 1} / ${triggers.length}`;
      }

      function open(index, fromEl) {
        triggerEl = fromEl;
        show(index);
        root.hidden = false;
        document.body.style.overflow = 'hidden';
        root.querySelector('.gallery__lightbox-close').focus();
        document.addEventListener('keydown', onKeydown);
      }

      function close() {
        root.hidden = true;
        document.body.style.overflow = '';
        document.removeEventListener('keydown', onKeydown);
        if (triggerEl) triggerEl.focus();
      }

      function onKeydown(e) {
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') show(currentIndex - 1);
        else if (e.key === 'ArrowRight') show(currentIndex + 1);
        else if (e.key === 'Tab') {
          // Simple focus trap across the dialog's few focusable controls.
          const focusable = root.querySelectorAll('button');
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }

      triggers.forEach((t, i) => {
        t.addEventListener('click', () => open(i, t));
      });
      closeEls.forEach((el) => el.addEventListener('click', close));
      prevBtn.addEventListener('click', () => show(currentIndex - 1));
      nextBtn.addEventListener('click', () => show(currentIndex + 1));
    })();
  </script>
)}

<style>
  .gallery {
    padding: var(--p-space-24) var(--p-space-8);
    background: var(--p-color-bg-primary);
  }

  .gallery--bg-secondary     { background: var(--p-color-bg-secondary); }
  .gallery--bg-accent-subtle { background: var(--p-color-bg-accent); }

  .gallery__inner {
    max-width: var(--p-container-wide);
    margin: 0 auto;
  }

  .gallery__header {
    max-width: var(--p-container-narrow);
    margin: 0 auto var(--p-space-16);
    text-align: center;
  }

  .gallery__eyebrow {
    font-size: var(--p-font-size-xs);
    font-weight: var(--p-font-weight-medium);
    letter-spacing: var(--p-font-tracking-wider);
    text-transform: uppercase;
    color: var(--p-color-text-tertiary);
    margin-bottom: var(--p-space-3);
  }

  .gallery__headline {
    font-family: var(--p-font-display);
    font-size: var(--p-font-size-3xl);
    font-weight: var(--p-font-weight-semibold);
    line-height: var(--p-font-leading-tight);
    color: var(--p-color-text-primary);
    margin-bottom: var(--p-space-4);
  }

  .gallery__body {
    font-size: var(--p-font-size-lg);
    font-weight: var(--p-font-weight-light);
    color: var(--p-color-text-secondary);
    line-height: var(--p-font-leading-relaxed);
  }

  /* ── Masonry (default) — CSS multi-column, natural aspect ratio ── */
  .gallery__grid {
    column-gap: var(--p-space-6);
  }

  .gallery--masonry .gallery__grid--2 { column-count: 2; }
  .gallery--masonry .gallery__grid--3 { column-count: 3; }
  .gallery--masonry .gallery__grid--4 { column-count: 4; }

  .gallery--masonry .gallery__tile {
    break-inside: avoid;
    margin-bottom: var(--p-space-6);
  }

  .gallery--masonry .gallery__img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--p-radius-md);
  }

  /* ── Grid — uniform square tiles via object-fit ── */
  .gallery--grid .gallery__grid {
    display: grid;
    gap: var(--p-space-6);
    grid-template-columns: repeat(3, 1fr);
  }

  .gallery--grid .gallery__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .gallery--grid .gallery__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .gallery--grid .gallery__grid--4 { grid-template-columns: repeat(4, 1fr); }

  .gallery--grid .gallery__tile {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--p-radius-md);
  }

  .gallery--grid .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .gallery--masonry .gallery__grid--3,
    .gallery--masonry .gallery__grid--4 {
      column-count: 2;
    }

    .gallery--grid .gallery__grid--3,
    .gallery--grid .gallery__grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .gallery--masonry .gallery__grid--2,
    .gallery--masonry .gallery__grid--3,
    .gallery--masonry .gallery__grid--4 {
      column-count: 1;
    }

    .gallery--grid .gallery__grid--2,
    .gallery--grid .gallery__grid--3,
    .gallery--grid .gallery__grid--4 {
      grid-template-columns: 1fr;
    }
  }

  /* ── Lightbox trigger — reset button chrome so it looks like the plain tile ── */
  .gallery__tile--button {
    display: block;
    width: 100%;
    padding: 0;
    background: none;
    border: none;
    font: inherit;
    cursor: zoom-in;
    text-align: left;
  }

  .gallery__tile--button:focus-visible {
    outline: var(--p-border-width-md) solid var(--p-color-accent-default);
    outline-offset: var(--p-space-1);
  }

  /* ── Lightbox modal ── */
  .gallery__lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__lightbox[hidden] { display: none; }

  .gallery__lightbox-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--p-color-bg-inverse) 92%, transparent);
  }

  .gallery__lightbox-dialog {
    position: relative;
    width: min(90vw, 75rem);
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery__lightbox-img {
    max-width: 100%;
    max-height: 85vh;
    width: auto;
    height: auto;
    display: block;
    border-radius: var(--p-radius-md);
  }

  .gallery__lightbox-close {
    position: absolute;
    top: calc(-1 * var(--p-space-12));
    right: 0;
    background: none;
    border: none;
    color: var(--p-color-text-on-dark);
    cursor: pointer;
    padding: var(--p-space-2);
  }

  .gallery__lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: color-mix(in srgb, var(--p-color-bg-inverse) 60%, transparent);
    border: none;
    border-radius: var(--p-radius-full);
    color: var(--p-color-text-on-dark);
    width: var(--p-space-12);
    height: var(--p-space-12);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }

  .gallery__lightbox-nav--prev { left: calc(-1 * var(--p-space-6)); }
  .gallery__lightbox-nav--next { right: calc(-1 * var(--p-space-6)); }

  .gallery__lightbox-count {
    position: absolute;
    bottom: calc(-1 * var(--p-space-10));
    left: 50%;
    transform: translateX(-50%);
    color: var(--p-color-text-on-dark);
    font-size: var(--p-font-size-sm);
    margin: 0;
  }

  @media (max-width: 640px) {
    .gallery__lightbox-nav--prev { left: var(--p-space-2); }
    .gallery__lightbox-nav--next { right: var(--p-space-2); }
    .gallery__lightbox-close { top: var(--p-space-2); right: var(--p-space-2); }
  }
</style>
